{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Janela principal; sem acesso genérico ao filesystem, shell ou SQL.",
  "windows": ["main"],
  "permissions": ["core:default", "core:window:allow-set-theme", "core:window:allow-close", "core:window:allow-minimize", "core:window:allow-toggle-maximize", "core:window:allow-start-dragging"]
}
