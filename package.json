{
  "name": "dinheirovisk",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "description": "Dinheirovisky — Seu bolso agradece. Finanças pessoais locais e offline.",
  "homepage": "https://dinheirovisky.app/",
  "repository": {
    "type": "git",
    "url": "https://github.com/DanielLinsAndrade/dinheirovisky.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "tauri": "tauri",
    "format": "prettier --write src index.html package.json tsconfig.json vite.config.ts",
    "format:check": "prettier --check src index.html package.json tsconfig.json vite.config.ts",
    "lint": "eslint src --max-warnings 0",
    "test:native": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/native/run.ps1",
    "validate": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/validate.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.13.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "26.1.0",
    "playwright-core": "1.63.0",
    "prettier": "^3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
